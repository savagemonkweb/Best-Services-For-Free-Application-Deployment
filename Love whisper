    },
    onError: (error) => {
      if (isUnauthorizedError(error as Error)) {
        toast({
          title: "Unauthorized",
          description: "You are logged out. Logging in again...",
          variant: "destructive",
        });
        setTimeout(() => {
          window.location.href = "/api/login";
        }, 500);
        return;
      }
      toast({
        title: "Error",
        description: "Failed to send message. Please try again.",
        variant: "destructive",
      });
    },
  });

  // Mark messages as read mutation
  const markAsReadMutation = useMutation({
    mutationFn: async () => {
      await apiRequest('PATCH', '/api/messages/read');
    },
    onError: (error) => {
      if (isUnauthorizedError(error as Error)) {
        toast({
          title: "Unauthorized",
          description: "You are logged out. Logging in again...",
          variant: "destructive",
        });
        setTimeout(() => {
          window.location.href = "/api/login";
        }, 500);
        return;
      }
    },
  });

  // Handle WebSocket messages
  useEffect(() => {
    if (!lastMessage) return;

    switch (lastMessage.type) {
      case 'new_message':
        queryClient.invalidateQueries({ queryKey: ['/api/messages'] });
        // Mark as read if the user is active
        markAsReadMutation.mutate();
        break;
      case 'typing_start':
        setIsPartnerTyping(true);
        break;
      case 'typing_stop':
        setIsPartnerTyping(false);
        break;
      case 'user_online':
        setPartnerOnlineStatus(true);
        break;
      case 'user_offline':
        setPartnerOnlineStatus(false);
        break;
    }
  }, [lastMessage, queryClient, markAsReadMutation]);

  // Auto-scroll to bottom when new messages arrive
  useEffect(() => {
    const messagesContainer = document.querySelector('.messages-container');
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }, [messages]);

  // Handle sending messages
  const handleSendMessage = (content: string) => {
    if (!content.trim()) return;
    sendMessageMutation.mutate({ content: content.trim() });
  };

  // Handle typing indicators
  const handleTypingStart = () => {
    sendTypingStart();
  };

  const handleTypingStop = () => {
    sendTypingStop();
  };

  if (authLoading || partnerLoading || messagesLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-bg-light">
        <Loader2 className="h-8 w-8 animate-spin text-primary" />
      </div>
    );
  }

  if (!partner) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-bg-light">
        <div className="text-center">
          <p className="text-accent">No partner found. Please contact support.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-screen bg-bg-light">
      <ChatHeader 
        partner={partner} 
        isOnline={partner.isOnline || partnerOnlineStatus}
        lastSeen={partner.lastSeen}
      />
      
      <div className="flex-1 overflow-y-auto px-4 py-6 space-y-4 messages-container">
        {/* Date separator */}
        <div className="flex justify-center">
          <span className="bg-white px-3 py-1 rounded-full text-xs text-accent border">
            Today
          </span>
        </div>
        
        {messages.map((message: Message) => (
          <MessageBubble
            key={message.id}
            message={message}
            isOwnMessage={message.senderId === user?.id}
            partner={partner}
          />
        ))}
        
        {isPartnerTyping && <TypingIndicator partner={partner} />}
      </div>
      
      <MessageInput
        onSendMessage={handleSendMessage}
        onTypingStart={handleTypingStart}
        onTypingStop={handleTypingStop}
        isLoading={sendMessageMutation.isPending}
      />
    </div>
  );
}import { Button } from '@/components/ui/button';
